set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY alu_dut
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "16:15:30  NOVEMBER 14, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "20.1.1 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name VHDL_FILE adder1bit.vhd
set_global_assignment -name VHDL_FILE adder8bit.vhd
set_global_assignment -name VHDL_FILE mux2.vhd
set_global_assignment -name VHDL_FILE mux4.vhd
set_global_assignment -name VHDL_FILE alulib.vhd
set_global_assignment -name VHDL_FILE alu.vhd
set_global_assignment -name VHDL_FILE alu_timing_top.vhd
set_global_assignment -name VHDL_FILE alu_dut_lib.vhd
set_global_assignment -name VHDL_FILE alu_dut.vhd
set_global_assignment -name SDC_FILE alu_timing_top.sdc
set_location_assignment PIN_P11 -to clk
set_global_assignment -name VECTOR_WAVEFORM_FILE alu.vwf
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name VIRTUAL_PIN ON -to ac[*]
set_instance_assignment -name VIRTUAL_PIN ON -to db[*]
set_instance_assignment -name VIRTUAL_PIN ON -to alus[*]
set_instance_assignment -name VIRTUAL_PIN ON -to dout[*]
set_location_assignment PIN_B12 -to alus[6]
set_location_assignment PIN_A13 -to alus[7]
set_location_assignment PIN_A12 -to alus[5]
set_location_assignment PIN_C12 -to alus[4]
set_location_assignment PIN_D12 -to alus[3]
set_location_assignment PIN_C11 -to alus[2]
set_location_assignment PIN_C14 -to alus[1]
set_location_assignment PIN_D14 -to dout[7]
set_location_assignment PIN_E14 -to dout[6]
set_location_assignment PIN_C13 -to dout[5]
set_location_assignment PIN_D13 -to dout[4]
set_location_assignment PIN_B10 -to dout[3]
set_location_assignment PIN_A10 -to dout[2]
set_location_assignment PIN_A9 -to dout[1]
set_location_assignment PIN_A8 -to dout[0]
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
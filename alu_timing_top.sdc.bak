# alu_timing_top.sdc - DE10-Lite (MAX 10), ρολόι 50 MHz στο PIN_P11
create_clock -name clk -period 20.000 -waveform {0.000 10.000} [get_ports{clk}]
derive_clock_uncertainty
# Οι θύρες είναι virtual pins: αναλύεται μόνο η διαδρομή reg-to-reg της ALU
set_false_path -from [get_ports {ac[*] db[*] alus[*]}]
set_false_path -to [get_ports {dout[*]}]